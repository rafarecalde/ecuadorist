---
import { Image } from "astro:assets";
import ArticleCard from "../components/ArticleCard.astro";
import ComingUp from "../components/ComingUp.astro";
import PhotoCredit from "../components/PhotoCredit.astro";
import PlanYourTrip from "../components/PlanYourTrip.astro";
import StatusStrip from "../components/StatusStrip.astro";
import ThisWeekBand from "../components/ThisWeekBand.astro";
import WeekendBand from "../components/WeekendBand.astro";
import Base from "../layouts/Base.astro";
import { upcomingFestivals } from "../data/events";
import { currentWeekend } from "../data/weekend";
import { site } from "../config/site";
import { allArticles, findArticle } from "../lib/articles";
import { allIssues, issuePath, latestIssue, todayIso } from "../lib/issues";
import { getPhoto } from "../lib/photos";

const articles = await allArticles();
const galapagos = findArticle(articles, "galapagos");
const quito = findArticle(articles, "quito");
const cuenca = findArticle(articles, "cuenca");
const places = ["banos", "otavalo", "mindo", "quilotoa", "the-coast", "the-amazon"].map((id) =>
  findArticle(articles, id),
);
const retire = ["cost-of-living", "best-cities", "visas", "healthcare", "banking", "renting"].map((id) =>
  findArticle(articles, id),
);
const eat = ["ecuadorian-food", "eating-in-quito", "where-to-stay"].map((id) => findArticle(articles, id));
const doing = ["hiking", "wildlife", "markets", "hot-springs"].map((id) => findArticle(articles, id));

const issues = await allIssues();
const issue = latestIssue(issues);
const weekend = currentWeekend();
const coming = upcomingFestivals(todayIso(), 3);

const hero = getPhoto("cotopaxi");
const wildlife = getPhoto("booby");
const retirePhoto = getPhoto("vilcabamba");
const eatPhoto = getPhoto("llapingachos");
const doPhoto = getPhoto("chimborazo");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: site.url,
  description: site.description,
  inLanguage: "en",
};
---

<Base title={site.name} description={site.description} image={hero.src.src} imageAlt={hero.alt} jsonLd={jsonLd}>
  <StatusStrip />
  <WeekendBand weekend={weekend} issueHref={issuePath(issue)} />
  <ThisWeekBand date={issue.data.date} href={issuePath(issue)} items={issue.data.items.slice(0, 3)} />
  <ComingUp events={coming} />
  <section class="hero hero-home" aria-label="Cover">
    <Image
      class="hero-img"
      src={hero.src}
      alt={hero.alt}
      widths={[768, 1200, 1800, 2200]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-scrim"></div>
    <div class="hero-copy">
      <p class="eyebrow">Cotopaxi National Park</p>
      <h1>Four worlds, one republic.</h1>
      <p class="lede">Andes, cloud forest, Amazon, and the Galápagos. A field guide for people who read before they book.</p>
      <a class="text-link" href="/visit/cotopaxi/">The Cotopaxi chapter</a>
      <p class="photo-credit"><PhotoCredit id={hero.id} /></p>
    </div>
  </section>

  <section class="facts" aria-label="The country in four figures">
    <div><strong>0°</strong><span>The equator</span></div>
    <div><strong>2,850 m</strong><span>Quito</span></div>
    <div><strong>5,897 m</strong><span>Cotopaxi</span></div>
    <div><strong>1,000 km</strong><span>To the Galápagos</span></div>
  </section>

  <section class="band">
    <div class="intro">
      <p>Ecuador is a capital in the clouds, a marble city in the south, a Pacific of humpback whales, and islands that rewrote biology.</p>
    </div>
  </section>

  <section class="band" style="padding-top: 0" aria-labelledby="visit-title">
    <div class="section-head">
      <p class="eyebrow">Visit</p>
      <h2 id="visit-title">Where to go</h2>
      <p class="dek">Short chapters on the places that actually explain the country.</p>
    </div>
    <div class="feature-grid">
      <ArticleCard article={galapagos} size="feature" showDek loading="eager" />
      <div class="stack">
        <ArticleCard article={quito} size="portrait" showDek />
        <ArticleCard article={cuenca} size="portrait" showDek />
      </div>
    </div>
    <div class="place-grid">
      {places.map((article) => <ArticleCard article={article} />)}
    </div>
    <p class="meta" style="padding-left: 0"><a class="text-link" href="/visit/">All ten places</a></p>
  </section>

  <a class="break" href="/do/wildlife/">
    <Image src={wildlife.src} alt={wildlife.alt} widths={[768, 1400, 1800]} sizes="100vw" />
    <div class="break-scrim"></div>
    <div class="break-copy">
      <p class="eyebrow">Do</p>
      <h2>Wildlife, at a respectful distance.</h2>
      <span class="text-link">The wildlife chapter</span>
    </div>
  </a>

  <section class="band" aria-labelledby="retire-title">
    <div class="split">
      <div>
        <p class="eyebrow">Retire &amp; Move</p>
        <h2 id="retire-title">Thinking of staying</h2>
        <p class="dek">Dollars, doctors, leases, and visas. The visa chapter is an overview, not legal advice.</p>
        <ul class="link-list">
          {
            retire.map((article) => (
              <li>
                <a href={`/${article.data.section}/${article.id}/`}>
                  {article.data.title}
                  <span>{article.data.kicker}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <figure class="card card-portrait" style="display:block">
        <Image src={retirePhoto.src} alt={retirePhoto.alt} widths={[640, 900, 1200]} sizes="(min-width: 900px) 42vw, 100vw" />
        <figcaption class="photo-credit" style="color: var(--muted)"><PhotoCredit id={retirePhoto.id} /></figcaption>
      </figure>
    </div>
  </section>

  <section class="band" style="padding-top: 0" aria-labelledby="table-title">
    <div class="split top">
      <div>
        <figure class="card-landscape" style="margin:0 0 1rem; overflow:hidden">
          <Image src={eatPhoto.src} alt={eatPhoto.alt} widths={[640, 1000]} sizes="(min-width: 900px) 46vw, 100vw" />
        </figure>
        <p class="eyebrow">Eat &amp; Stay</p>
        <h2 id="table-title">The table</h2>
        <ul class="link-list">
          {
            eat.map((article) => (
              <li>
                <a href={`/${article.data.section}/${article.id}/`}>
                  {article.data.title}
                  <span>Read</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <figure class="card-landscape" style="margin:0 0 1rem; overflow:hidden">
          <Image src={doPhoto.src} alt={doPhoto.alt} widths={[640, 1000]} sizes="(min-width: 900px) 46vw, 100vw" />
        </figure>
        <p class="eyebrow">Do</p>
        <h2>Out of the city</h2>
        <ul class="link-list">
          {
            doing.map((article) => (
              <li>
                <a href={`/${article.data.section}/${article.id}/`}>
                  {article.data.title}
                  <span>Read</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <PlanYourTrip ids={["airalo", "klook", "uio"]} note="Three useful things" />
</Base>
