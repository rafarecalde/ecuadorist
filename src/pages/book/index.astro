---
import { Image } from "astro:assets";
import PhotoCredit from "../../components/PhotoCredit.astro";
import Base from "../../layouts/Base.astro";
import { bookPages, bookPath } from "../../data/book";
import { getPhoto } from "../../lib/photos";

const description =
  "Sixteen short pages for booking a day or a lodge week: Cotopaxi, Quilotoa, Otavalo, Cuicocha and Peguche, Mindo, Baños, Chimborazo, Papallacta, Cuenca and Cajas, an Amazon lodge, the TelefériQo, Galápagos days and how to book them, an Ecuador eSIM, and a car at Quito airport.";
---

<Base title="Plan & book" description={description}>
  <header class="page-title">
    <p class="eyebrow">Book</p>
    <h1>Plan &amp; book</h1>
    <p class="dek">
      Sixteen pages for the searches with a date attached: the volcanoes, the crater, the market and the lakes, the cloud forest, the gorge, the hot springs, the Amazon, the cable car, the islands, a phone line, and a car at the airport.
    </p>
  </header>
  <section class="band book-hub" aria-label="Pages">
    <ul class="hub-grid">
      {
        bookPages.map((page, index) => {
          const photo = getPhoto(page.hero);
          return (
            <li class="hub-card">
              <a href={bookPath(page)}>
                <figure>
                  <Image
                    src={photo.src}
                    alt={photo.alt}
                    widths={[480, 800, 1200]}
                    sizes="(min-width: 900px) 30vw, (min-width: 640px) 45vw, 100vw"
                    loading={index < 2 ? "eager" : "lazy"}
                  />
                </figure>
                <p class="eyebrow">{page.eyebrow}</p>
                <h2>{page.title}</h2>
                <p>{page.dek}</p>
              </a>
              <p class="photo-credit is-ink">
                <PhotoCredit id={photo.id} />
              </p>
            </li>
          );
        })
      }
    </ul>
  </section>
</Base>
