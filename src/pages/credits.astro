---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { bookPages, bookPath } from "../data/book";
import { festivals } from "../data/events";
import { weekends } from "../data/weekend";
import { allArticles, articlePath } from "../lib/articles";
import { allIssues, issuePath } from "../lib/issues";
import { getPhoto, photoIds } from "../lib/photos";

const articles = await allArticles();
const issues = await allIssues();
const usage = new Map<string, { href: string; title: string }[]>();

function addUse(id: string, href: string, title: string) {
  const list = usage.get(id) ?? [];
  if (!list.some((item) => item.href === href)) {
    list.push({ href, title });
  }
  usage.set(id, list);
}

for (const article of articles) {
  addUse(article.data.hero, articlePath(article), article.data.title);
}

for (const issue of issues) {
  addUse(issue.data.hero, issuePath(issue), issue.data.title);
  for (const item of issue.data.items) {
    addUse(item.photo, issuePath(issue), issue.data.title);
  }
}

for (const festival of festivals) {
  addUse(festival.hero, `/events/${festival.id}/`, festival.title);
}

for (const page of bookPages) {
  addUse(page.hero, bookPath(page), page.title);
  addUse(page.hero, "/book/", "Plan & book");
  for (const pick of page.picks) {
    addUse(pick.photo, bookPath(page), page.title);
  }
}

for (const weekend of Object.values(weekends)) {
  for (const item of weekend.items) {
    addUse(item.photo, `/this-week/${weekend.id}/`, "This Week in Ecuador");
  }
}

const description = "Photographers and licenses for every image on Ecuadorist, all from Wikimedia Commons.";
---

<Base title="Photo credits" description={description}>
  <article class="credits">
    <p class="eyebrow">Colophon</p>
    <h1>Photo credits</h1>
    <p class="dek">
      Every photograph is from Wikimedia Commons, under a license that allows publication here. Non-commercial licenses were not used. Titles link to the original file.
    </p>
    <ul class="credit-list">
      {
        photoIds.map((id) => {
          const photo = getPhoto(id);
          const used = usage.get(id) ?? [];
          return (
            <li>
              <Image src={photo.src} alt={photo.alt} widths={[480, 800]} sizes="(min-width: 800px) 16rem, 100vw" />
              <div>
                <h2>
                  <a href={photo.sourceUrl}>{photo.alt}</a>
                </h2>
                <p>
                  {photo.author}. {photo.license}.{" "}
                  <a href={photo.licenseUrl}>License</a>.
                </p>
                {used.length > 0 && (
                  <p>
                    Used in{" "}
                    {used.map((item, index) => (
                      <>
                        {index > 0 && ", "}
                        <a href={item.href}>{item.title}</a>
                      </>
                    ))}
                    .
                  </p>
                )}
              </div>
            </li>
          );
        })
      }
    </ul>
  </article>
</Base>
