---
import Base from "../layouts/Base.astro";

const description = "That page is not in the Ecuadorist guide.";
---

<Base title="Page not found" description={description}>
  <article class="legal">
    <p class="eyebrow">404</p>
    <h1>This page is not on the map.</h1>
    <p>The chapter may have moved. Start from the beginning, or choose a section.</p>
    <ul class="link-list">
      <li><a href="/">Home <span>Cover</span></a></li>
      <li><a href="/visit/">Visit <span>Places</span></a></li>
      <li><a href="/retire/">Retire &amp; Move <span>Practical</span></a></li>
      <li><a href="/eat/">Eat &amp; Stay <span>Table</span></a></li>
      <li><a href="/do/">Do <span>Outdoors</span></a></li>
    </ul>
  </article>
</Base>
