---
import { Image } from "astro:assets";
import PhotoCredit from "./PhotoCredit.astro";
import TrackedLink from "./TrackedLink.astro";
import { getPhoto } from "../lib/photos";
import type { Weekend } from "../data/weekend";

interface Props {
  weekend: Weekend;
  issueHref?: string;
}

const { weekend, issueHref } = Astro.props;
---

<section class="weekend" aria-labelledby="weekend-title">
  <div class="weekend-head">
    <p class="eyebrow">This weekend in Ecuador</p>
    <h2 id="weekend-title">{weekend.range}</h2>
    <p class="dek">{weekend.name}</p>
  </div>
  <div class="weekend-grid">
    {
      weekend.items.map((item) => {
        const photo = getPhoto(item.photo);
        const external = item.sourceUrl.startsWith("http");
        return (
          <article class="weekend-card">
            <Image src={photo.src} alt={photo.alt} widths={[640, 960, 1400]} sizes="(min-width: 900px) 34vw, 100vw" />
            <div class="weekend-scrim"></div>
            <div class="weekend-copy">
              <p class="eyebrow">{item.when}</p>
              <h3>{item.headline}</h3>
              <p>
                {item.place}. {item.line}
              </p>
              <p class="weekend-links">
                {item.partner && <TrackedLink id={item.partner} />}
                {item.partnerHref && item.partnerLabel && (
                  <TrackedLink href={item.partnerHref} label={item.partnerLabel} />
                )}
                {external ? (
                  <a href={item.sourceUrl} target="_blank" rel="noopener">
                    {item.sourceName}
                  </a>
                ) : (
                  <a href={item.sourceUrl}>{item.sourceName}</a>
                )}
              </p>
              <p class="photo-credit">
                <PhotoCredit id={photo.id} />
              </p>
            </div>
          </article>
        );
      })
    }
  </div>
  {
    issueHref && (
      <p class="weekend-more">
        <a class="text-link" href={issueHref}>
          The full week
        </a>
      </p>
    )
  }
</section>
