---
import { Image } from "astro:assets";
import PhotoCredit from "./PhotoCredit.astro";
import { getPhoto } from "../lib/photos";
import { formatLongDate } from "../lib/issues";

interface Props {
  date: string;
  href: string;
  items: { headline: string; photo: string; text: string }[];
}

const { date, href, items } = Astro.props;
---

<section class="band week-band" aria-labelledby="week-title">
  <div class="section-head">
    <p class="eyebrow">This week in Ecuador</p>
    <h2 id="week-title">{formatLongDate(date)}</h2>
    <p class="dek">Three things from the latest issue.</p>
  </div>
  <div class="week-grid">
    {
      items.map((item) => {
        const photo = getPhoto(item.photo);
        return (
          <a class="week-card" href={href}>
            <Image src={photo.src} alt={photo.alt} widths={[640, 960, 1200]} sizes="(min-width: 800px) 30vw, 100vw" />
            <div>
              <h3>{item.headline}</h3>
              <p>{item.text.split(". ")[0]}.</p>
              <p class="photo-credit is-ink">
                <PhotoCredit id={photo.id} />
              </p>
            </div>
          </a>
        );
      })
    }
  </div>
  <p class="meta" style="padding-left: 0">
    <a class="text-link" href={href}>Read the issue</a>
  </p>
</section>
