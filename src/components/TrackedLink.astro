---
import { getAffiliate, isAffiliateId, linkRel } from "../config/affiliates";

interface Props {
  id?: string;
  href?: string;
  label?: string;
}

const { id, href, label } = Astro.props;
if (id && !isAffiliateId(id)) {
  throw new Error(`Unknown affiliate “${id}”`);
}
const affiliate = id && isAffiliateId(id) ? getAffiliate(id) : undefined;
const url = affiliate?.href ?? href;
const text = label ?? affiliate?.name;
if (!url || !text) {
  throw new Error("A tracked link needs an affiliate id or an href and label");
}
const rel = affiliate ? linkRel(affiliate) : "sponsored nofollow noopener";
---

<a class="text-link" href={url} target="_blank" rel={rel}>{text}</a>
