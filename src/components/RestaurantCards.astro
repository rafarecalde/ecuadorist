---
import { Image } from "astro:assets";
import PhotoCredit from "./PhotoCredit.astro";
import { getPhoto } from "../lib/photos";

interface Place {
  name: string;
  neighborhood: string;
  cuisine: string;
  price?: "$" | "$$" | "$$$";
  photo: string;
  text: string;
  maps: string;
  website?: string;
}

interface Props {
  places: Place[];
}

const { places } = Astro.props;
---

<section class="restaurant-band" aria-label="Restaurants">
  <ul class="restaurant-grid">
    {
      places.map((place, index) => {
        const photo = getPhoto(place.photo);
        return (
          <li class="restaurant-card">
            <figure>
              <Image
                src={photo.src}
                alt={photo.alt}
                widths={[480, 800, 1200]}
                sizes="(min-width: 900px) 32vw, 100vw"
                loading={index === 0 ? "eager" : "lazy"}
              />
            </figure>
            <div class="restaurant-body">
              <p class="eyebrow">
                {place.neighborhood} · {place.cuisine}
                {place.price ? ` · ${place.price}` : ""}
              </p>
              <h2>{place.name}</h2>
              <p>{place.text}</p>
              <p class="photo-credit">
                <PhotoCredit id={photo.id} />
              </p>
              <p class="restaurant-links">
                <a class="text-link" href={place.maps} target="_blank" rel="noopener">
                  Google Maps
                </a>
                {place.website && (
                  <a class="text-link" href={place.website} target="_blank" rel="noopener">
                    Website
                  </a>
                )}
              </p>
            </div>
          </li>
        );
      })
    }
  </ul>
</section>
