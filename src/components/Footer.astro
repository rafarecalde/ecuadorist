---
import { sections } from "../config/site";
import { travelStatus } from "../data/status";

const { advisory } = travelStatus;
---

<footer class="footer">
  <div class="footer-grid">
    <div>
      <a class="wordmark" href="/">Ecuadorist</a>
      <p>An English-language guide to Ecuador for travelers, nomads, and people thinking of staying.</p>
    </div>
    <div>
      <h2>The guide</h2>
      <ul>
        {
          Object.entries(sections).map(([id, section]) => (
            <li>
              <a href={`/${id}/`}>{id === "retire" ? "Retiring in Ecuador" : section.title}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h2>The fine print</h2>
      <ul>
        <li><a href="/book/">Plan &amp; book</a></li>
        <li><a href="/this-week/">This Week</a></li>
        <li><a href="/events/">Events</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/affiliate-disclosure/">Affiliate disclosure</a></li>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/credits/">Photo credits</a></li>
      </ul>
    </div>
  </div>
  <p class="footer-advisory">
    Travel advisory:
    <a href={advisory.href} target="_blank" rel="noopener">
      {advisory.level} · {advisory.label}
    </a>
    <span>as of {advisory.asOf}</span>
    <a href="/visit/is-ecuador-safe/">By area</a>
  </p>
  <div class="footer-base">
    <span>© {new Date().getFullYear()} Ecuadorist</span>
    <span>Photographs remain with their creators.</span>
  </div>
</footer>
